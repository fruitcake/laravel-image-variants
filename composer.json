{
    "name": "fruitcake/laravel-image-variants",
    "description": "On-demand image variants that generate once and are served statically thereafter.",
    "keywords": ["laravel", "image", "thumbnail", "resize", "variants", "srcset", "on-demand"],
    "homepage": "https://github.com/fruitcake/laravel-image-variants",
    "license": "MIT",
    "authors": [
        {
            "name": "Barry vd. Heuvel",
            "email": "barryvdh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "illuminate/console": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/image": "^13.20",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.20",
        "intervention/image": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0|^13.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "twig/twig": "Required to use the Twig variant()/srcset() functions (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "Fruitcake\\ImageVariants\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fruitcake\\ImageVariants\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fruitcake\\ImageVariants\\ImageVariantsServiceProvider"
            ],
            "aliases": {
                "Variants": "Fruitcake\\ImageVariants\\Facades\\Variants"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
